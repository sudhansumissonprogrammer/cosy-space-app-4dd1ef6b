{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dqepeywgftbpxeeqfuwt.supabase.co/auth/v1",
    "resource": "https://dqepeywgftbpxeeqfuwt.supabase.co/functions/v1/mcp",
    "resource_name": "ShopBanao MCP",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "shopbanao-mcp",
      "version": "0.1.0",
      "title": "ShopBanao MCP"
    },
    "tools": [
      {
        "name": "list_stores",
        "title": "List public stores",
        "description": "List published storefronts on ShopBanao. Returns store slug, name, description, and logo. Use search to filter by name/slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional case-insensitive substring to match on name or slug.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_store",
        "title": "Get store details",
        "description": "Fetch a single published ShopBanao storefront by its slug. Returns public store info (name, description, contact, logo, theme).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Store slug, e.g. 'serdiyajewellers'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_products",
        "title": "List store products",
        "description": "List active products for a ShopBanao store by slug. Optional search filters by product name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Store slug the products belong to."
            },
            "search": {
              "description": "Optional case-insensitive substring match on product name.",
              "type": "string"
            },
            "limit": {
              "description": "Max rows to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
