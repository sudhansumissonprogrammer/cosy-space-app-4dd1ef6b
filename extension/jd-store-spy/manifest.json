{
  "manifest_version": 3,
  "name": "JD Store Spy",
  "version": "1.0.0",
  "description": "Private insights panel for stores built on JD WebShop / JD WebNShip / JD WebConnect. Shows store profile, catalog, days running, and estimated top sellers.",
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "48": "icon.png", "128": "icon.png" },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://*.jdwebshop.com/*",
    "https://*.jdwebnship.com/*",
    "https://*.jdwebconnect.com/*",
    "https://byeetjlpwzpy.jdwebnship.in/*",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://*.jdwebshop.com/*",
      "https://*.jdwebnship.com/*",
      "https://*.jdwebconnect.com/*"
    ],
    "js": ["content.js"],
    "css": ["panel.css"],
    "run_at": "document_idle"
  }],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["stores.json", "panel.html"], "matches": ["<all_urls>"] }
  ]
}
